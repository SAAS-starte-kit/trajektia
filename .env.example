# Neo4j (archive locale — source uniquement pour Le Siphon)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Supabase PostgreSQL (connexion directe pour ETL + FastAPI)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# O*NET Web Services API v2
ONET_API_KEY=your_onet_api_key_here
ONET_BASE_URL=https://api-v2.onetcenter.org/

# FastAPI Stitcher
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["https://your-brilliant-directories-domain.com"]

# Directus Cloud
DIRECTUS_URL=https://your-project.directus.app
DIRECTUS_TOKEN=your_directus_static_token_here

# Adzuna Job Search API (Canada / Québec)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
