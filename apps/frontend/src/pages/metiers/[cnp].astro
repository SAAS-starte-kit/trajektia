              <!-- Tags PTPD & Établissements -->
              <div class="mt-3.5 flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
                  ✓ Admissible PTPD (IRCC)
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200/60 dark:border-sky-800/40">
                  📍 Offert en Régions
                </span>
              </div>
            </div>

            {f.lien_interne && (
              <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-700/60">
                <a 
                  href={f.lien_interne}
                  class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center gap-1"
                >
                  <span>Vérifier les préalables scolaires</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>


  )}

  <!-- ============================================================ -->
  <!-- SECTION MÉTIERS CONNEXES & PASSERELLES (CKG) -->
  <!-- ============================================================ -->
  {metier.metiers_connexes && metier.metiers_connexes.length > 0 && (
  <section class="mb-12">
    <div class="bg-white dark:bg-slate-800/90 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-700/80 shadow-xl">
      
      <div class="mb-4">
        <div class="flex items-center gap-2">
          <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight">
            Métiers Connexes & Passerelles de Reconversion
          </h2>
          <InfoBubble 
            title="Similarité Vectorielle & Passerelles"
            description="Ce pourcentage calcule le degré de recoupement entre les compétences, tâches et outils requis par ce métier et ceux du métier cible. Un score élevé (ex: > 75 %) indique une transition fluide avec un minimum de requalification."
            source="Career Knowledge Graph (Cos-Sim)"
            badge="CKG"
            align="left"
          />
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
          Calculé par similarité vectorielle de compétences dans le Career Knowledge Graph Trajektia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
        {metier.metiers_connexes.map((connexe) => (
          <a 
            href={`/metiers/${connexe.cnp}`}
            class="group p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/50 hover:bg-white dark:hover:bg-slate-800 border border-slate-200/70 dark:border-slate-700/50 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs mb-1.5">
                <span class="font-bold text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">CNP {connexe.cnp}</span>
                <span class="font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 rounded-full border border-indigo-200/60 dark:border-indigo-800/50">{connexe.compatibilite_pourcentage}% similarité</span>
              </div>
              <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 leading-snug transition-colors">
                {connexe.titre}
              </h4>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between text-[11px] font-semibold text-indigo-600 dark:text-indigo-400">
              <span>Consulter la fiche</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  )}

  <!-- Script interactif d'inscription Lead Capture -->
  <script>
    const form = document.getElementById('lead-capture-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('lead-email-input') as HTMLInputElement | null;
    const successMsg = document.getElementById('lead-success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value || '';
      // On extrait le CNP via data-cnp ou l'URL (avec filtre sur segments non-vides pour gérer un éventuel trailing slash)
      const cnp = form?.dataset.cnp || window.location.pathname.split('/').filter(Boolean).pop() || '';

      if (email && successMsg) {
        try {
          const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
          const response = await fetch(`${apiUrl}/api/leads`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, cnp }),
          });

          if (response.ok) {
            successMsg.textContent = `✓ Merci ! Vous êtes bien inscrit(e) aux alertes.`;
            successMsg.className = "mt-3 text-xs text-emerald-400 font-semibold";
            successMsg.classList.remove('hidden');
            if (emailInput) emailInput.value = '';
          } else {
            successMsg.textContent = "❌ Erreur lors de l'abonnement. Veuillez réessayer.";
            successMsg.className = "mt-3 text-xs text-rose-400 font-semibold";
            successMsg.classList.remove('hidden');
            console.error("Erreur lors de l'abonnement");
          }
        } catch (err) {
          successMsg.textContent = "❌ Erreur de connexion au serveur.";
          successMsg.className = "mt-3 text-xs text-rose-400 font-semibold";
          successMsg.classList.remove('hidden');
          console.error("Erreur de connexion", err);
        }
      }
    });
  </script>

</BaseLayout>
