---
// ============================================================
// src/pages/metiers/index.astro
// Répertoire interactif des fiches métiers Trajektia (CKG)
// ============================================================
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { METIERS_DATA } from '../../data/metiers';

const totalMetiers = METIERS_DATA.length;
const totalOffres = METIERS_DATA.reduce((acc, m) => acc + (m.offres_emploi?.length || 0), 0);
const secteurs = [...new Set(METIERS_DATA.map(m => m.secteur))].sort();
---

<BaseLayout 
  title="Fiches Métiers, Salaires, RIASEC & Offres d'Emploi | Trajektia Québec" 
  description="Explorez les fiches métiers du Career Knowledge Graph québécois : salaires StatCan, profils RIASEC, insertion Relance Québec, compétences vertes ESCO et offres d'emploi en direct."
>
  <!-- En-tête de page -->
  <div class="max-w-4xl mx-auto text-center mb-10 pt-2">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold bg-indigo-100/80 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/60 mb-3 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Career Knowledge Graph (CKG) • Données Officielles Québec
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
      Fiches Métiers, Salaires & <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-indigo-600 via-purple-500 to-amber-500 dark:from-indigo-400 dark:via-purple-300 dark:to-amber-300 bg-clip-text text-transparent">
        Offres d'Emploi en Direct
      </span>
    </h1>

    <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Analysez les professions québécoises avec les données officielles de <strong>Statistique Canada</strong>, l'enquête <strong>Relance Québec</strong>, la typologie <strong>RIASEC</strong>, le profil d'effort <strong>DPC</strong> et les compétences écologiques <strong>ESCO</strong>.
    </p>

    <!-- Stats rapides -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto mt-6">
      <div class="p-3 rounded-2xl bg-white/60 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 shadow-sm backdrop-blur-sm">
        <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400">{totalMetiers}</div>
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Métiers pilotes CKG</div>
      </div>
      <div class="p-3 rounded-2xl bg-white/60 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 shadow-sm backdrop-blur-sm">
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{totalOffres}+</div>
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Offres en direct</div>
      </div>
      <div class="p-3 rounded-2xl bg-white/60 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 shadow-sm backdrop-blur-sm">
        <div class="text-2xl font-black text-purple-600 dark:text-purple-400">RIASEC</div>
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Profils Holland</div>
      </div>
      <div class="p-3 rounded-2xl bg-white/60 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 shadow-sm backdrop-blur-sm">
        <div class="text-2xl font-black text-teal-600 dark:text-teal-400">Relance</div>
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Insertion diplômés</div>
      </div>
    </div>
  </div>

  <!-- Barre de recherche et filtres -->
  <div class="max-w-5xl mx-auto mb-8 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-3xl p-4 sm:p-5 border border-slate-200/80 dark:border-slate-700/70 shadow-lg shadow-slate-900/5">
    <div class="flex flex-col md:flex-row gap-3">
      <!-- Input de recherche -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="metier-search-input"
          placeholder="Rechercher un métier, CNP, compétence (Python, CCQ, soins)..." 
          class="w-full pl-10 pr-4 py-3 text-sm rounded-2xl bg-slate-100/80 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
        />
      </div>

      <!-- Filtre RIASEC -->
      <div class="w-full md:w-48">
        <select 
          id="riasec-filter"
          class="w-full py-3 px-3.5 text-sm rounded-2xl bg-slate-100/80 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer"
        >
          <option value="">Tous les RIASEC</option>
          <option value="R">R - Réaliste (Pratique/Manuel)</option>
          <option value="I">I - Investigateur (Logique/Recherche)</option>
          <option value="A">A - Artistique (Créatif)</option>
          <option value="S">S - Social (Aide/Santé)</option>
          <option value="E">E - Entreprenant (Affaires/Leader)</option>
          <option value="C">C - Conventionnel (Méthode/Chiffres)</option>
        </select>
      </div>

      <!-- Filtre Secteur -->
      <div class="w-full md:w-52">
        <select 
          id="secteur-filter"
          class="w-full py-3 px-3.5 text-sm rounded-2xl bg-slate-100/80 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer"
        >
          <option value="">Tous les secteurs</option>
          {secteurs.map(secteur => (
            <option value={secteur}>{secteur}</option>
          ))}
        </select>
      </div>

      <!-- Filtre FEER / Niveau -->
      <div class="w-full md:w-44">
        <select 
          id="feer-filter"
          class="w-full py-3 px-3.5 text-sm rounded-2xl bg-slate-100/80 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer"
        >
          <option value="">Tous les niveaux</option>
          <option value="1">FEER 1 (Universitaire)</option>
          <option value="2">FEER 2 (Collégial / DEP)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Grille des Métiers -->
  <div id="metiers-grid" class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
    {METIERS_DATA.map((metier) => (
      <article 
        class="metier-card flex flex-col justify-between bg-white dark:bg-slate-800/90 rounded-3xl p-6 border border-slate-200/90 dark:border-slate-700/80 shadow-md hover:shadow-xl hover:border-indigo-400 dark:hover:border-indigo-500/50 transition-all duration-300 group"
        data-title={metier.titre.toLowerCase() + " " + metier.titre_court.toLowerCase()}
        data-cnp={metier.cnp}
        data-secteur={metier.secteur}
        data-feer={metier.feer.toString()}
        data-riasec={metier.riasec.code_holland}
        data-skills={metier.competences ? metier.competences.techniques_oasis.concat(metier.competences.vertes_esco).join(' ').toLowerCase() : ''}
      >
        <div>
          <!-- Tags et badges -->
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                CNP {metier.cnp}
              </span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/40">
                FEER {metier.feer}
              </span>
              <!-- Badge RIASEC Holland -->
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                RIASEC {metier.riasec.code_holland}
              </span>
            </div>
            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${metier.badge_couleur}`}>
              {metier.secteur}
            </span>
          </div>

          <!-- Titre -->
          <h2 class="text-xl font-black text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">
            <a href={`/metiers/${metier.cnp}`} class="hover:underline">
              {metier.titre_court}
            </a>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5 font-medium">
            {metier.titre}
          </p>

          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">
            {metier.description}
          </p>

          <!-- Bloc Salaires & Insertion Relance -->
          <div class="mt-5 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/50 grid grid-cols-2 gap-3 text-center">
            <div>
              <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Salaire médian</span>
              <span class="text-lg font-black text-slate-900 dark:text-white">
                {metier.salaire.horaire_median.toFixed(2)} $ <span class="text-xs font-normal text-slate-500">/h</span>
              </span>
              <span class="block text-[11px] text-indigo-600 dark:text-indigo-400 font-bold">~{Math.round(metier.salaire.annuel_median / 1000)} k$ /an</span>
            </div>
            <div>
              <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Relance Québec</span>
              <span class="inline-flex items-center gap-1 text-sm font-black text-emerald-600 dark:text-emerald-400 mt-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {metier.relance_quebec?.taux_emploi_en_rapport || "N/D"}
              </span>
              <span class="block text-[11px] text-slate-500 font-medium">en emploi direct</span>
            </div>
          </div>

          <!-- Aperçu RIASEC & Compétence Verte -->
          <div class="mt-3.5 space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Traits Holland dominants :</span>
              <span class="font-bold text-purple-600 dark:text-purple-400">{metier.riasec.traits_dominants.join(' • ')}</span>
            </div>
            {metier.competences?.vertes_esco && metier.competences.vertes_esco.length > 0 && (
            <div class="text-xs leading-relaxed text-slate-700 dark:text-slate-200 bg-emerald-50/80 dark:bg-emerald-950/40 px-3 py-2 rounded-xl border border-emerald-200/70 dark:border-emerald-800/60 flex items-start gap-2">
              <span class="text-sm shrink-0">🌿</span>
              <div class="min-w-0 flex-1">
                <span class="font-bold text-emerald-800 dark:text-emerald-300 not-italic">ESCO :</span>
                <span class="italic text-slate-600 dark:text-slate-300 ml-1">"{metier.competences.vertes_esco[0]}"</span>
              </div>
            </div>
            )}
          </div>

          <!-- Section Offres d'emploi en direct -->
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between text-xs">
            <span class="inline-flex items-center gap-1.5 font-semibold text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
              {(metier.offres_emploi?.length || 0)} offres d'emploi disponibles
            </span>
            {metier.offres_emploi && metier.offres_emploi.length > 0 && (
              <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/70 px-2 py-0.5 rounded-md">
                {metier.offres_emploi[0].source}
              </span>
            )}
          </div>
        </div>

        <!-- Bouton CTA vers la fiche -->
        <div class="mt-5 pt-3">
          <a 
            href={`/metiers/${metier.cnp}`}
            class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-2xl bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-bold text-sm shadow-md shadow-indigo-600/20 hover:shadow-lg transition-all"
          >
            <span>Consulter la fiche & offres</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- Message aucun résultat -->
  <div id="no-results" class="hidden max-w-md mx-auto text-center py-12">
    <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto text-slate-400 mb-3">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-base font-bold text-slate-900 dark:text-white">Aucun métier ne correspond à votre recherche</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Essayez un autre mot-clé ou réinitialisez les filtres.</p>
  </div>

  <!-- Script interactif de recherche côté client -->
  <script>
    import { SYNONYMES_TCC } from '../../data/synonymes_tcc';

    const searchInput = document.getElementById('metier-search-input') as HTMLInputElement | null;
    const riasecSelect = document.getElementById('riasec-filter') as HTMLSelectElement | null;
    const secteurSelect = document.getElementById('secteur-filter') as HTMLSelectElement | null;
    const feerSelect = document.getElementById('feer-filter') as HTMLSelectElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.metier-card');
    const noResultsMsg = document.getElementById('no-results');

    // Normalisation du texte (enlève les accents)
    function normalizeText(text: string): string {
      return text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
    }

    function filterMetiers() {
      const rawQuery = (searchInput?.value || '').trim();
      const queryNorm = normalizeText(rawQuery);
      const riasec = (riasecSelect?.value || '').trim().toUpperCase();
      const secteur = (secteurSelect?.value || '').trim();
      const feer = (feerSelect?.value || '').trim();

      // Recherche des CNP équivalentes via le dictionnaire de synonymes TCC
      const matchedCnpsFromSynonyms = new Set<string>();
      if (queryNorm) {
        SYNONYMES_TCC.forEach(mapping => {
          const termeNorm = normalizeText(mapping.terme);
          if (queryNorm.includes(termeNorm) || termeNorm.includes(queryNorm)) {
            mapping.cnps.forEach(cnp => matchedCnpsFromSynonyms.add(cnp));
          }
        });
      }

      let visibleCount = 0;

      cards.forEach(card => {
        const title = normalizeText(card.getAttribute('data-title') || '');
        const cnp = card.getAttribute('data-cnp') || '';
        const cardSecteur = card.getAttribute('data-secteur') || '';
        const cardFeer = card.getAttribute('data-feer') || '';
        const cardRiasec = card.getAttribute('data-riasec') || '';
        const skills = normalizeText(card.getAttribute('data-skills') || '');

        const matchesDirectQuery = !queryNorm || 
          title.includes(queryNorm) || 
          cnp.includes(queryNorm) || 
          skills.includes(queryNorm);

        const matchesSynonym = matchedCnpsFromSynonyms.has(cnp);
        const matchesQuery = matchesDirectQuery || matchesSynonym;

        const matchesRiasec = !riasec || cardRiasec.includes(riasec);
        const matchesSecteur = !secteur || cardSecteur === secteur;
        const matchesFeer = !feer || cardFeer === feer;

        if (matchesQuery && matchesRiasec && matchesSecteur && matchesFeer) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', filterMetiers);
    riasecSelect?.addEventListener('change', filterMetiers);
    secteurSelect?.addEventListener('change', filterMetiers);
    feerSelect?.addEventListener('change', filterMetiers);
  </script>
</BaseLayout>
