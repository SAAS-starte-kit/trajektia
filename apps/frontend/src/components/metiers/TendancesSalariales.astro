---
// ============================================================
// src/components/metiers/TendancesSalariales.astro
// Composant Observatoire du Marché & Courbe des Tendances 12 Mois
// Modélisation Trajektia Live™ adossée aux données ouvertes Guichet-Emplois
// ============================================================
import InfoBubble from '../ui/InfoBubble.astro';
import type { TendancesMarche12M, SalaireStatCan } from '../../data/metiers';

interface Props {
  tendances?: TendancesMarche12M;
  salaireStatCan: SalaireStatCan;
  titreMetier: string;
}

const { tendances, salaireStatCan, titreMetier } = Astro.props;

// Filtrer ou vérifier l'historique
const points = tendances?.historique && tendances.historique.length > 0 ? tendances.historique : [];
const hasData = points.length >= 2;

// Calcul des dimensions SVG
const svgWidth = 640;
const svgHeight = 220;
const padding = { top: 30, right: 30, bottom: 42, left: 60 };
const innerWidth = svgWidth - padding.left - padding.right;
const innerHeight = svgHeight - padding.top - padding.bottom;

// Échelle des salaires
const salaries = points.map(p => p.salaire_median).filter(s => s && s > 0);
const rawMin = salaries.length > 0 ? Math.min(...salaries) : salaireStatCan.annuel_median * 0.85;
const rawMax = salaries.length > 0 ? Math.max(...salaries) : salaireStatCan.annuel_median * 1.15;
const salaryMin = Math.max(10000, Math.floor((rawMin * 0.95) / 1000) * 1000);
const salaryMax = Math.ceil((rawMax * 1.05) / 1000) * 1000;
const salaryRange = Math.max(5000, salaryMax - salaryMin);

// Échelle des volumes pour les barres en arrière-plan
const volumes = points.map(p => p.volume_offres || 0);
const maxVolume = Math.max(10, ...volumes);

// Coordonnées des points
const svgPoints = points.map((p, index) => {
  const x = padding.left + (index / (points.length - 1)) * innerWidth;
  const clampedSalary = Math.min(salaryMax, Math.max(salaryMin, p.salaire_median || salaireStatCan.annuel_median));
  const y = padding.top + (1 - (clampedSalary - salaryMin) / salaryRange) * innerHeight;
  const barHeight = ((p.volume_offres || 0) / maxVolume) * (innerHeight * 0.45);
  const barY = padding.top + innerHeight - barHeight;
  return {
    ...p,
    x,
    y,
    barY,
    barHeight
  };
});

// Points pour les étiquettes X (1 sur 2 si dense)
const labeledPoints = svgPoints.filter((_, idx) => {
  return points.length <= 8 || idx % 2 === 0 || idx === points.length - 1;
});

// Construction du chemin SVG (Line)
const linePathD = svgPoints.length > 0
  ? `M ${svgPoints.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L ')}`
  : '';

// Construction du chemin de l'aire remplie (Area)
const areaPathD = svgPoints.length > 0
  ? `${linePathD} L ${svgPoints[svgPoints.length - 1].x.toFixed(1)},${(padding.top + innerHeight).toFixed(1)} L ${svgPoints[0].x.toFixed(1)},${(padding.top + innerHeight).toFixed(1)} Z`
  : '';

// Grilles de repères horizontaux
const gridLevels = [
  { val: salaryMin, label: `${Math.round(salaryMin / 1000)}k $`, y: padding.top + innerHeight },
  { val: salaryMin + salaryRange * 0.5, label: `${Math.round((salaryMin + salaryRange * 0.5) / 1000)}k $`, y: padding.top + innerHeight * 0.5 },
  { val: salaryMax, label: `${Math.round(salaryMax / 1000)}k $`, y: padding.top }
];

// Dernier point disponible
const latestPoint = svgPoints[svgPoints.length - 1];
const firstPoint = svgPoints[0];

// Métriques dynamiques
const growth12m = tendances?.croissance_salaire_12m_pct !== undefined 
  ? tendances.croissance_salaire_12m_pct 
  : (latestPoint && firstPoint && firstPoint.salaire_median > 0
      ? Math.round(((latestPoint.salaire_median - firstPoint.salaire_median) / firstPoint.salaire_median) * 1000) / 10
      : null);

const demandGrowth12m = tendances?.croissance_demande_12m_pct;
const latestSalary = latestPoint?.salaire_median || salaireStatCan.annuel_median;
const deltaStatCan = salaireStatCan.annuel_median > 0
  ? Math.round(((latestSalary - salaireStatCan.annuel_median) / salaireStatCan.annuel_median) * 1000) / 10
  : 0;

// Badges et styles dynamiques
function getStatusBadge(croissance: number | null): { text: string; bg: string; textCol: string; border: string } {
  if (croissance === null) return { text: "Données émergentes", bg: "bg-slate-100 dark:bg-slate-800", textCol: "text-slate-600 dark:text-slate-400", border: "border-slate-300 dark:border-slate-700" };
  if (croissance >= 8) return { text: "Forte hausse", bg: "bg-emerald-50 dark:bg-emerald-950/60", textCol: "text-emerald-700 dark:text-emerald-300", border: "border-emerald-300 dark:border-emerald-800" };
  if (croissance >= 2) return { text: "Croissance stable", bg: "bg-teal-50 dark:bg-teal-950/60", textCol: "text-teal-700 dark:text-teal-300", border: "border-teal-300 dark:border-teal-800" };
  if (croissance >= -2) return { text: "Stabilité du marché", bg: "bg-blue-50 dark:bg-blue-950/60", textCol: "text-blue-700 dark:text-blue-300", border: "border-blue-300 dark:border-blue-800" };
  return { text: "Ralentissement", bg: "bg-amber-50 dark:bg-amber-950/60", textCol: "text-amber-700 dark:text-amber-300", border: "border-amber-300 dark:border-amber-800" };
}

const statusBadge = getStatusBadge(growth12m);
---

<div id="tendances-marche" class="bg-white dark:bg-slate-800/90 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-700/80 shadow-lg mb-8 transition-all">
  
  <!-- EN-TÊTE DE LA SECTION -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-slate-100 dark:border-slate-700/60">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/70 dark:border-indigo-800/60">
          <span class="w-2 h-2 rounded-full bg-indigo-600 dark:bg-indigo-400 animate-pulse"></span>
          Observatoire Temporel Trajektia Live™
        </span>
        <span class={`px-2.5 py-0.5 rounded-full text-xs font-bold border ${statusBadge.bg} ${statusBadge.textCol} ${statusBadge.border}`}>
          {statusBadge.text}
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
        Dynamique Salariale & Demande d'Embauche (12 Mois)
        <InfoBubble 
          title="Observatoire des Tendances Trajektia Live™"
          description="Séries temporelles calculées mensuellement par agrégation continue des offres d'emploi officielles publiées sur Guichet-Emplois Canada (Données ouvertes CKAN). Le salaire en direct reflète la rémunération médiane effectivement offerte par les employeurs, mise en regard du référentiel gouvernemental StatCan."
          source="Guichet-Emplois Canada (CKAN) & Trajektia CKG"
          badge="12 Mois Glissants"
          align="left"
        />
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
        Historique mensuel des salaires affichés et du volume de postes ouverts pour {titreMetier}.
      </p>
    </div>

    <!-- BADGE SALAIRE LIVE DU MOIS -->
    <div class="flex sm:flex-col items-center sm:items-end justify-between bg-slate-50 dark:bg-slate-900/60 p-3 sm:p-4 rounded-2xl border border-slate-200/70 dark:border-slate-700/60">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Salaire Marché Live</span>
      <div class="text-xl sm:text-2xl font-black text-indigo-600 dark:text-indigo-400">
        ~{latestSalary.toLocaleString('fr-CA')} $ <span class="text-xs font-normal text-slate-500">/ an</span>
      </div>
      <div class="flex items-center gap-1.5 text-xs font-semibold">
        <span class="text-slate-500">vs StatCan :</span>
        <span class={`font-bold ${deltaStatCan >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'}`}>
          {deltaStatCan >= 0 ? `+${deltaStatCan}` : deltaStatCan} %
        </span>
      </div>
    </div>
  </div>

  <!-- KPI CARDS : 3 COLONNES -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    
    <!-- KPI 1 : ÉVOLUTION SALARIALE SUR 1 AN -->
    <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-50/60 to-purple-50/40 dark:from-indigo-950/30 dark:to-purple-950/20 border border-indigo-100/80 dark:border-indigo-900/50">
      <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-800 dark:text-indigo-300 flex items-center gap-1">
        📈 Évolution Salariale 12M
      </span>
      <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">
        {growth12m !== null ? `${growth12m > 0 ? '+' : ''}${growth12m.toFixed(1)} %` : 'N/D'}
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        {growth12m !== null && growth12m >= 0 
          ? 'Progression de la rémunération proposée par les recruteurs sur 12 mois.' 
          : 'Stabilisation ou rééquilibrage de la fourchette d\'embauche.'}
      </p>
    </div>

    <!-- KPI 2 : MOMENTUM DE RECRUTEMENT -->
    <div class="p-4 rounded-2xl bg-gradient-to-br from-teal-50/60 to-emerald-50/40 dark:from-teal-950/30 dark:to-emerald-950/20 border border-teal-100/80 dark:border-teal-900/50">
      <span class="text-[11px] font-bold uppercase tracking-wider text-teal-800 dark:text-teal-300 flex items-center gap-1">
        🎯 Momentum d'Embauche
      </span>
      <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">
        {latestPoint?.volume_offres || 0} <span class="text-sm font-semibold text-slate-500">postes récents</span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        {demandGrowth12m !== undefined && demandGrowth12m !== null
          ? `Dynamique de l'offre : ${demandGrowth12m > 0 ? '+' : ''}${demandGrowth12m.toFixed(1)} % sur 12 mois.`
          : 'Volume actif relevé sur les babillards officiels.'}
      </p>
    </div>

    <!-- KPI 3 : RATIO TÉLÉTRAVAIL / HYBRIDE -->
    <div class="p-4 rounded-2xl bg-gradient-to-br from-blue-50/60 to-cyan-50/40 dark:from-blue-950/30 dark:to-cyan-950/20 border border-blue-100/80 dark:border-blue-900/50">
      <span class="text-[11px] font-bold uppercase tracking-wider text-blue-800 dark:text-blue-300 flex items-center gap-1">
        💻 Télétravail & Hybride
      </span>
      <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">
        {latestPoint?.ratio_teletravail !== undefined && latestPoint.ratio_teletravail !== null 
          ? `${latestPoint.ratio_teletravail.toFixed(1)} %` 
          : 'Présentiel'}
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Part des offres stipulant une possibilité formelle de travail à distance ou virtuel.
      </p>
    </div>

  </div>

  <!-- ZONE GRAPHIQUE SVG NATIF RESPONSIVE -->
  {hasData ? (
    <div class="relative bg-slate-50/80 dark:bg-slate-900/70 rounded-2xl p-3 sm:p-4 border border-slate-200/70 dark:border-slate-700/60 overflow-hidden">
      
      <!-- LÉGENDE DU GRAPHIQUE -->
      <div class="flex flex-wrap items-center justify-between text-xs text-slate-500 dark:text-slate-400 mb-2 px-2">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-1 rounded bg-indigo-600 dark:bg-indigo-400"></span>
            <span class="font-medium text-slate-700 dark:text-slate-300">Salaire annuel médian affiché</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded bg-indigo-200/80 dark:bg-indigo-900/60"></span>
            <span class="font-medium text-slate-500">Volume d'offres (barres)</span>
          </div>
        </div>
        <div class="text-[11px] italic">
          Survolez un point pour inspecter les détails du mois
        </div>
      </div>

      <!-- SVG INTERACTIF -->
      <div class="w-full overflow-x-auto">
        <svg 
          viewBox={`0 0 ${svgWidth} ${svgHeight}`} 
          class="w-full h-auto min-w-[540px] text-xs select-none"
          aria-label={`Graphique d'évolution temporelle des salaires pour ${titreMetier}`}
        >
          <defs>
            <!-- Dégradé sous la courbe -->
            <linearGradient id="gradient-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#6366f1" stop-opacity="0.25" />
              <stop offset="90%" stop-color="#6366f1" stop-opacity="0.01" />
            </linearGradient>

            <!-- Dégradé de la ligne -->
            <linearGradient id="gradient-line" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#818cf8" />
              <stop offset="50%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#4f46e5" />
            </linearGradient>
          </defs>

          <!-- LIGNES DE GRILLE HORIZONTALES ET VALEURS Y -->
          {gridLevels.map(lvl => (
            <g>
              <line 
                x1={padding.left} 
                y1={lvl.y} 
                x2={svgWidth - padding.right} 
                y2={lvl.y} 
                stroke="currentColor" 
                stroke-dasharray="3,3" 
                stroke-opacity="0.15" 
                stroke-width="1"
              />
              <text 
                x={padding.left - 8} 
                y={lvl.y + 4} 
                text-anchor="end" 
                fill="currentColor" 
                class="text-[10px] font-semibold fill-slate-400 dark:fill-slate-500"
              >
                {lvl.label}
              </text>
            </g>
          ))}

          <!-- BARRES DE VOLUME D'OFFRES EN ARRIÈRE-PLAN -->
          {svgPoints.map(p => (
            <rect 
              x={p.x - 7} 
              y={p.barY} 
              width="14" 
              height={Math.max(2, p.barHeight)} 
              rx="3"
              class="fill-indigo-100 dark:fill-indigo-950/60 hover:fill-indigo-300 dark:hover:fill-indigo-800 transition-colors"
            >
              <title>{`${p.mois_label} : ${p.volume_offres} offres d'emploi publiées`}</title>
            </rect>
          ))}

          <!-- AIRE DE DÉGRADÉ -->
          <path d={areaPathD} fill="url(#gradient-area)" />

          <!-- COURBE DU SALAIRE (LINE) -->
          <path 
            d={linePathD} 
            fill="none" 
            stroke="url(#gradient-line)" 
            stroke-width="3" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          />

          <!-- POINTS DE DONNÉES MENSUELS -->
          {svgPoints.map((p, idx) => {
            const isLast = idx === svgPoints.length - 1;
            return (
              <g class="group cursor-pointer">
                {isLast && (
                  <circle 
                    cx={p.x} 
                    cy={p.y} 
                    r="8" 
                    class="fill-indigo-400/30 animate-ping"
                  />
                )}
                <circle 
                  cx={p.x} 
                  cy={p.y} 
                  r={isLast ? "5" : "3.5"} 
                  class="fill-white dark:fill-slate-900 stroke-indigo-600 dark:stroke-indigo-400 group-hover:scale-150 transition-transform origin-center" 
                  stroke-width={isLast ? "2.5" : "2"}
                />
                <title>{`${p.mois_label}\nSalaire annuel médian : ${p.salaire_median.toLocaleString('fr-CA')} $\nÉquivalent horaire : ~${p.salaire_horaire.toFixed(2)} $/h\nOffres observées : ${p.volume_offres}`}</title>
              </g>
            );
          })}

          <!-- ÉTIQUETTES X (MOIS) -->
          {labeledPoints.map(p => (
            <text 
              x={p.x} 
              y={svgHeight - 12} 
              text-anchor="middle" 
              class="text-[10px] font-semibold fill-slate-500 dark:fill-slate-400"
            >
              {p.mois_label}
            </text>
          ))}
        </svg>
      </div>

      <!-- NOTE DE BAS DE GRAPHIQUE -->
      <div class="flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 mt-2 px-1 pt-2 border-t border-slate-200/50 dark:border-slate-800/50">
        <span>Source primaire : Guichet-Emplois Canada • Données Ouvertes CKAN</span>
        <span>Modélisation Trajektia Live™</span>
      </div>

    </div>
  ) : (
    <!-- FALLBACK SI DONNÉES INSUFFISANTES POUR CE MÉTIER -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/80 text-center">
      <div class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">
        Historique en cours de consolidation pour cette profession
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
        Le référentiel officiel Statistique Canada ({salaireStatCan.horaire_median.toFixed(2)} $/h, soit ~{salaireStatCan.annuel_median.toLocaleString('fr-CA')} $/an) fait foi. L'observatoire continu Trajektia agrégera le flux des prochains mois pour construire la série temporelle.
      </p>
    </div>
  )}

</div>
