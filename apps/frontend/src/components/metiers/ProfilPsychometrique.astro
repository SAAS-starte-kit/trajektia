---
// ============================================================
// ProfilPsychometrique.astro
// Composant pour afficher le profil RIASEC, Triade DPC et les 21 facettes
// ============================================================
import type { FicheMetier } from '../../data/metiers';
import { SCIENTIFIC_EVIDENCE } from '../../data/scientific-evidence';

interface Props {
  metier: FicheMetier;
}

const { metier } = Astro.props;

// Calcul des coordonnées de Prediger (simplifié pour démo)
// Normalement calculé selon les scores RIASEC ou DPC
const predigerX = metier.dpc ? (metier.dpc.travail_equipe.score - metier.dpc.precision_manuelle.score) * 10 : 0; // -100 à 100
const predigerY = metier.dpc ? (metier.dpc.aptitude_cognitive.score - metier.dpc.force_physique.score) * 10 : 0; // -100 à 100

// Evidence data
const onetEvidence = SCIENTIFIC_EVIDENCE['bigfive_onet_workstyles'];
const predigerEvidence = SCIENTIFIC_EVIDENCE['prediger_bifurcation_dpc'];

const riasecColors: Record<string, string> = {
  'realiste': 'bg-red-500',
  'investigateur': 'bg-amber-500',
  'artistique': 'bg-yellow-400',
  'social': 'bg-green-500',
  'entreprenant': 'bg-blue-500',
  'conventionnel': 'bg-purple-500'
};
---

<div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 dark:border-slate-700/60 mb-8">
  <div class="flex items-center gap-3 mb-6">
    <div class="p-3 bg-purple-100 dark:bg-purple-900/50 rounded-xl text-purple-600 dark:text-purple-400">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
      </svg>
    </div>
    <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">Profil Psychométrique & DPC</h2>
  </div>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Colonne 1: RIASEC -->
    <div class="space-y-6">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Code Holland (RIASEC)</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">{metier.riasec.description}</p>
        
        <div class="space-y-3">
          {Object.entries(metier.riasec.scores).sort((a, b) => b[1] - a[1]).map(([key, score]) => (
            <div class="flex items-center gap-3">
              <span class="w-24 text-sm font-semibold capitalize text-slate-700 dark:text-slate-300">{key}</span>
              <div class="flex-1 h-3 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${riasecColors[key] || 'bg-indigo-500'}`} style={`width: ${score}%`}></div>
              </div>
              <span class="w-10 text-right text-xs font-bold text-slate-500 dark:text-slate-400">{score}%</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Section O*NET 21 Facettes (Pro Only) -->
      <div class="pro-only mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
        <div class="flex items-center gap-2 mb-3">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">21 Facettes Détaillées (Work Styles O*NET / Big Five)</h3>
          {onetEvidence && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400 border border-green-200 dark:border-green-800">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Consensus {onetEvidence.consensus_percentage}%
            </span>
          )}
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 italic">
          {onetEvidence?.statement_fr || "Correspondance validée avec les dimensions du Big Five (OCEAN / IPIP-50)."}
        </p>
        
        {metier.onet_work_styles ? (
          <div class="grid grid-cols-2 gap-2">
            {metier.onet_work_styles.map(ws => (
              <div class="flex items-center justify-between p-2 rounded bg-slate-50 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-700">
                <span class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate pr-2" title={ws.description}>{ws.nom}</span>
                <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400">{ws.score}/100</span>
              </div>
            ))}
          </div>
        ) : (
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
            <p class="text-sm text-slate-500 dark:text-slate-400">Les données O*NET détaillées ne sont pas disponibles pour ce métier.</p>
          </div>
        )}

        {onetEvidence && onetEvidence.key_papers && onetEvidence.key_papers.length > 0 && (
          <details class="mt-4 text-xs text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700 shadow-sm">
            <summary class="font-bold cursor-pointer hover:text-indigo-600 dark:hover:text-indigo-400 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              Sources scientifiques (Consensus {onetEvidence.consensus_percentage}%)
            </summary>
            <div class="mt-3 space-y-2 border-t border-slate-100 dark:border-slate-700 pt-2">
              <p class="italic">"{onetEvidence.consensus_summary}"</p>
              <ul class="list-disc pl-4 space-y-1.5 mt-2">
                {onetEvidence.key_papers.map(paper => (
                  <li>
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{paper.authors} ({paper.year})</span>. {paper.title}. <i class="text-slate-500">{paper.journal}</i>.
                    {paper.doi && <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" class="text-indigo-500 hover:underline ml-1">[{paper.doi}]</a>}
                    {paper.open_access_url && <a href={paper.open_access_url} target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline ml-1">(PDF gratuit)</a>}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )}
      </div>
    </div>

    <!-- Colonne 2: Prediger et DPC -->
    <div class="space-y-6">
      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Modèle de Prediger (DPC)</h3>
          {predigerEvidence && (
            <span class="pro-only inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400 border border-green-200 dark:border-green-800">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Consensus {predigerEvidence.consensus_percentage}%
            </span>
          )}
        </div>
        
        <p class="pro-only text-xs text-slate-500 dark:text-slate-400 mb-4 italic">
          {predigerEvidence?.statement_fr || "Modèle bi-axial reliant les intérêts aux exigences fonctionnelles."}
        </p>

        <!-- Graphique Prediger CSS -->
        <div class="relative w-full aspect-square max-w-[280px] mx-auto bg-slate-50 dark:bg-slate-900/50 rounded-full border-2 border-slate-200 dark:border-slate-700 my-6 shadow-inner">
          <!-- Axes -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-full h-px bg-slate-300 dark:bg-slate-600"></div>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="h-full w-px bg-slate-300 dark:bg-slate-600"></div>
          </div>
          
          <!-- Labels -->
          <span class="absolute top-2 left-1/2 -translate-x-1/2 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Données</span>
          <span class="absolute bottom-2 left-1/2 -translate-x-1/2 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Idées</span>
          <span class="absolute left-2 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Choses</span>
          <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Personnes</span>

          <!-- Point de données -->
          <div 
            class="absolute w-4 h-4 bg-indigo-600 rounded-full border-2 border-white dark:border-slate-800 shadow-md transform -translate-x-1/2 -translate-y-1/2 transition-all duration-700 ease-out"
            style={`left: ${50 + (predigerX / 2)}%; top: ${50 - (predigerY / 2)}%;`}
          >
            <div class="absolute inset-0 bg-indigo-400 rounded-full animate-ping opacity-75"></div>
          </div>
        </div>
      </div>

      <!-- Tableau DPC (Data/People/Things) -->
      {metier.dpc && (
        <div class="grid grid-cols-3 gap-2 text-center mt-4">
          <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800/50">
            <div class="text-xs font-bold text-blue-800 dark:text-blue-300 uppercase tracking-wide mb-1">Données</div>
            <div class="text-2xl font-black text-blue-600 dark:text-blue-400">{metier.dpc.aptitude_cognitive.score}</div>
          </div>
          <div class="p-3 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl border border-emerald-100 dark:border-emerald-800/50">
            <div class="text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wide mb-1">Personnes</div>
            <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{metier.dpc.travail_equipe.score}</div>
          </div>
          <div class="p-3 bg-amber-50 dark:bg-amber-900/20 rounded-xl border border-amber-100 dark:border-amber-800/50">
            <div class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wide mb-1">Choses</div>
            <div class="text-2xl font-black text-amber-600 dark:text-amber-400">{metier.dpc.precision_manuelle.score}</div>
          </div>
        </div>
      )}

      {predigerEvidence && predigerEvidence.key_papers && predigerEvidence.key_papers.length > 0 && (
        <details class="pro-only mt-4 text-xs text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700 shadow-sm">
          <summary class="font-bold cursor-pointer hover:text-indigo-600 dark:hover:text-indigo-400 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            Sources scientifiques (Consensus {predigerEvidence.consensus_percentage}%)
          </summary>
          <div class="mt-3 space-y-2 border-t border-slate-100 dark:border-slate-700 pt-2">
            <p class="italic">"{predigerEvidence.consensus_summary}"</p>
            <ul class="list-disc pl-4 space-y-1.5 mt-2">
              {predigerEvidence.key_papers.map(paper => (
                <li>
                  <span class="font-semibold text-slate-700 dark:text-slate-300">{paper.authors} ({paper.year})</span>. {paper.title}. <i class="text-slate-500">{paper.journal}</i>.
                  {paper.doi && <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" class="text-indigo-500 hover:underline ml-1">[{paper.doi}]</a>}
                  {paper.open_access_url && <a href={paper.open_access_url} target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline ml-1">(PDF gratuit)</a>}
                </li>
              ))}
            </ul>
          </div>
        </details>
      )}
    </div>
  </div>

  <!-- SECTION BIG FIVE (OCEAN) SI DISPONIBLE -->
  {metier.big_five && (
    <div class="mt-6 pt-6 border-t border-slate-200/80 dark:border-slate-700/80">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <h3 class="text-sm font-black text-slate-900 dark:text-white tracking-tight">
            Profil de Personnalité au Travail (Modèle OCEAN / Big Five)
          </h3>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-400 border border-purple-200 dark:border-purple-800">
            Psychométrie
          </span>
        </div>
        <span class="text-[11px] text-slate-400 font-medium">Scores normalisés sur 100</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/50 text-center">
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Ouverture</span>
          <div class="text-base font-black text-slate-900 dark:text-white my-0.5">{metier.big_five.ouverture} %</div>
          <span class="text-[9px] text-slate-400 block">Curiosité / Innovation</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/50 text-center">
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Conscience</span>
          <div class="text-base font-black text-slate-900 dark:text-white my-0.5">{metier.big_five.conscientieux} %</div>
          <span class="text-[9px] text-slate-400 block">Rigueur / Fiabilité</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/50 text-center">
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Extraversion</span>
          <div class="text-base font-black text-slate-900 dark:text-white my-0.5">{metier.big_five.extraversion} %</div>
          <span class="text-[9px] text-slate-400 block">Énergie / Contact</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/50 text-center">
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Agréabilité</span>
          <div class="text-base font-black text-slate-900 dark:text-white my-0.5">{metier.big_five.agreabilite} %</div>
          <span class="text-[9px] text-slate-400 block">Coopération / Écoute</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-700/50 text-center col-span-2 sm:col-span-1">
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Stabilité ém.</span>
          <div class="text-base font-black text-slate-900 dark:text-white my-0.5">{metier.big_five.stabilite_emotionnelle} %</div>
          <span class="text-[9px] text-slate-400 block">Gestion du stress</span>
        </div>
      </div>
    </div>
  )}
</div>
