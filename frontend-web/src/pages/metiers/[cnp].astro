          <div class="flex gap-1 my-2">
            {[1, 2, 3, 4, 5].map(i => (
              <div class={`h-2 flex-1 rounded-full ${i <= metier.dpc.resolution_problemes.score ? 'bg-purple-500' : 'bg-slate-200 dark:bg-slate-700'}`}></div>
            ))}
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">{metier.dpc.resolution_problemes.details}</p>
        </div>

        <!-- Jauge 5 : Précision Manuelle -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/50">
          <div class="text-xs font-bold text-slate-500 dark:text-slate-400">Précision Manuelle</div>
          <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">{metier.dpc.precision_manuelle.label}</div>
          <div class="flex gap-1 my-2">
            {[1, 2, 3, 4, 5].map(i => (
              <div class={`h-2 flex-1 rounded-full ${i <= metier.dpc.precision_manuelle.score ? 'bg-emerald-500' : 'bg-slate-200 dark:bg-slate-700'}`}></div>
            ))}
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">{metier.dpc.precision_manuelle.details}</p>
        </div>

      </div>

      <!-- Conditions & Cadre de travail -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-2xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/70 dark:border-slate-700/50 text-xs">
        <div>
          <span class="font-bold text-slate-900 dark:text-white block mb-0.5">🏢 Environnement de travail typique :</span>
          <span class="text-slate-600 dark:text-slate-300">{metier.dpc.environnement_travail}</span>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block mb-0.5">⏱️ Rythme et horaires :</span>
          <span class="text-slate-600 dark:text-slate-300">{metier.dpc.rythme}</span>
        </div>
      </div>

    </div>
  </section>

</section>
  )}

  <!-- ============================================================ -->
  <!-- SECTION FORMATIONS QUÉBÉCOISES ET PRÉALABLES (DEC / DEP / UNIV) -->
  <!-- ============================================================ -->
  {metier.formations && metier.formations.length > 0 && (
  <section id="formations" class="mb-10">
    <div class="bg-white dark:bg-slate-800/90 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-700/80 shadow-xl">
      
      <div class="mb-6">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Formations Recommandées au Québec
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
          Parcours de formation collégiaux (DEC), professionnels (DEP) ou universitaires menant à cette profession.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {metier.formations.map((f) => (
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 rounded-lg text-xs font-black bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300">
                  {f.type} {f.code ? `• ${f.code}` : ''}
                </span>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{f.duree}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
                {f.titre}
              </h3>
              <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {f.description}
              </p>
            </div>

            {f.lien_interne && (
              <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-700/60">
                <a 
                  href={f.lien_interne}
                  class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center gap-1"
                >
                  <span>Vérifier les préalables scolaires</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

</section>
  )}

  <!-- ============================================================ -->
  <!-- SECTION MÉTIERS CONNEXES & PASSERELLES (CKG) -->
  <!-- ============================================================ -->
  {metier.metiers_connexes && metier.metiers_connexes.length > 0 && (
  <section class="mb-12">
    <div class="bg-white dark:bg-slate-800/90 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-700/80 shadow-xl">
      
      <div class="mb-4">
        <div class="flex items-center gap-2">
          <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight">
            Métiers Connexes & Passerelles de Reconversion
          </h2>
          <InfoBubble 
            title="Similarité Vectorielle & Passerelles"
            description="Ce pourcentage calcule le degré de recoupement entre les compétences, tâches et outils requis par ce métier et ceux du métier cible. Un score élevé (ex: > 75 %) indique une transition fluide avec un minimum de requalification."
            source="Career Knowledge Graph (Cos-Sim)"
            badge="CKG"
            align="left"
          />
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
          Calculé par similarité vectorielle de compétences dans le Career Knowledge Graph Trajektia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
        {metier.metiers_connexes.map((connexe) => (
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-700/50 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs mb-1.5">
                <span class="font-bold text-slate-500">CNP {connexe.cnp}</span>
                <span class="font-black text-indigo-600 dark:text-indigo-400">{connexe.compatibilite_pourcentage}% similarité</span>
              </div>
              <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 leading-snug">
                {connexe.titre}
              </h4>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</section>
  )}

  <!-- Script interactif d'inscription Lead Capture -->
  <script>
    const form = document.getElementById('lead-capture-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('lead-email-input') as HTMLInputElement | null;
    const successMsg = document.getElementById('lead-success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value || '';
      // On extrait le CNP de l'URL pour l'associer au lead
      const urlParts = window.location.pathname.split('/');
      const cnp = urlParts[urlParts.length - 1];

      if (email && successMsg) {
        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, cnp }),
          });

          if (response.ok) {
            successMsg.classList.remove('hidden');
            if (emailInput) emailInput.value = '';
          } else {
            console.error("Erreur lors de l'abonnement");
          }
        } catch (err) {
          console.error("Erreur de connexion", err);
        }
      }
    });
  </script>

</BaseLayout>
