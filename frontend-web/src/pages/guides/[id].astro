---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { ChevronLeft, BookOpen, Clock, Tag } from 'lucide-react';
import ShareButton from '../../components/ShareButton';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { Content, headings } = await render(entry);

// Calcul approximatif du temps de lecture (200 mots par minute)
const wordCount = entry.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${entry.data.title} | Trajektia`} description={entry.data.description}>
  <div class="max-w-4xl mx-auto">
    <!-- Fil d'ariane -->
    <a href="/guides" class="inline-flex items-center gap-2 text-sm text-brand-blue hover:underline mb-6 font-medium">
      <ChevronLeft size={16} /> Retour aux guides
    </a>

    <!-- En-tête de l'article (Hero) -->
    <div class="bg-white dark:bg-slate-800/50 rounded-3xl p-8 md:p-10 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 mb-8 relative overflow-hidden">
      <div class="absolute top-0 right-0 -mt-10 -mr-10 text-brand-blue/10 dark:text-brand-blue/5 pointer-events-none">
        <BookOpen size={250} />
      </div>
      
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            {entry.data.categorie && (
              <span class="px-3 py-1 bg-amber-100 dark:bg-brand-yellow/10 text-amber-900 dark:text-brand-yellow border border-amber-200 dark:border-brand-yellow/20 rounded-full text-xs font-bold uppercase tracking-wider">
                {entry.data.categorie}
              </span>
            )}
            <span class="flex items-center gap-1.5 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <Clock size={14} /> {readingTime} min de lecture
            </span>
          </div>
          
          <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-4 leading-tight tracking-tight">
            {entry.data.title}
          </h1>
          <p class="text-xl text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
            {entry.data.description}
          </p>
        </div>
        
        <div class="shrink-0 flex md:flex-col gap-3">
          <ShareButton 
            title={`${entry.data.title} - Trajektia`}
            text={entry.data.description}
            variant="solid" 
            client:idle
          />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Contenu de l'article -->
      <div class="lg:col-span-3">
        <article class="bg-white dark:bg-slate-800/50 rounded-3xl p-8 md:p-10 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 prose prose-lg prose-slate dark:prose-invert max-w-none 
          prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white prose-headings:tracking-tight
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-700/50 prose-h2:pb-3
          prose-h3:text-xl prose-h3:text-brand-blue
          prose-a:text-brand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
          prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-extrabold
          prose-ul:bg-slate-50 dark:prose-ul:bg-slate-900/50 prose-ul:p-6 prose-ul:rounded-2xl prose-ul:list-none prose-ul:space-y-2 prose-ul:border prose-ul:border-slate-100 dark:prose-ul:border-transparent
          prose-li:flex prose-li:items-start prose-li:gap-3
          prose-li:before:content-[''] prose-li:before:w-2 prose-li:before:h-2 prose-li:before:bg-brand-yellow prose-li:before:rounded-full prose-li:before:mt-2
        ">
          <Content />
        </article>
      </div>

      <!-- Colonne Latérale (Table des matières & Tags) -->
      <div class="lg:col-span-1 space-y-6">
        {headings && headings.length > 0 && (
          <div class="bg-white dark:bg-slate-800/50 rounded-3xl p-6 shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 sticky top-24">
            <h3 class="font-bold text-slate-900 dark:text-white mb-4 uppercase tracking-wider text-sm">Au sommaire</h3>
            <ul class="space-y-3 text-sm">
              {headings.map((heading: any) => (
                <li class={`leading-tight ${heading.depth > 2 ? 'pl-4 text-slate-500 dark:text-slate-400' : 'font-semibold text-slate-800 dark:text-white'}`}>
                  <a href={`#${heading.slug}`} class="hover:text-brand-blue transition-colors block">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-sm ring-1 ring-slate-200 dark:ring-transparent text-slate-900 dark:text-white">
            <h3 class="font-bold mb-4 flex items-center gap-2">
              <Tag size={18} class="text-amber-500 dark:text-brand-yellow" /> Mots-clés
            </h3>
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag: string) => (
                <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800/50/10 text-slate-600 dark:text-gray-300 rounded-full text-xs font-medium border border-slate-200 dark:border-white/20">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</BaseLayout>
