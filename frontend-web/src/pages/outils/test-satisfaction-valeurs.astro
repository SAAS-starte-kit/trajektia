---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SatisfactionTest from '../../components/SatisfactionTest';

const title = "Satisfaction & valeurs de travail (TWA) | Trajektia";
const description = "Évaluez ce qui vous satisfait durablement au travail grâce au test O*NET Work Importance Locator basé sur la Theory of Work Adjustment (TWA).";
---

<BaseLayout title={title} description={description}>
  <div class="py-4">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Fil d'Ariane">
      <a href="/" class="hover:text-indigo-500 transition-colors">Accueil</a>
      <span class="text-slate-300 dark:text-slate-600">/</span>
      <a href="/outils" class="hover:text-indigo-500 transition-colors">Outils</a>
      <span class="text-slate-300 dark:text-slate-600">/</span>
      <span class="text-slate-700 dark:text-slate-200 font-medium">Test de satisfaction & valeurs</span>
    </nav>

    <!-- Composant React interactif -->
    <SatisfactionTest client:idle />
  </div>
</BaseLayout>
