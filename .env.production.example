# ============================================================
# TRAJEKTIA — Variables d'environnement Production (VPS OVH)
# ATTENTION : Ne jamais committer ce fichier. Il est dans .gitignore.
# Copier ce fichier en .env sur le VPS et remplir toutes les valeurs.
# ============================================================

# ── Domaine principal ────────────────────────────────────────
DOMAIN=trajektia.ca
ACME_EMAIL=admin@trajektia.ca

# ── Traefik Dashboard ────────────────────────────────────────
# Générer avec : htpasswd -nb admin motdepasse_fort
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

# ── PostgreSQL (Coffre-fort local) ───────────────────────────
POSTGRES_PASSWORD=CHANGER_MOI_motdepasse_fort_32_chars

# ── PostgREST ────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
PGRST_JWT_SECRET=CHANGER_MOI_jwt_secret_32_chars

# ── Directus CMS (Archivé - Scénario B / Simplification) ────────
# Note: Service retiré de docker-compose.prod.yml le 2026-09-24
# DIRECTUS_SECRET=
# DIRECTUS_ADMIN_EMAIL=
# DIRECTUS_ADMIN_PASSWORD=
# DIRECTUS_TOKEN=

# ── Neo4j (MemMachine CKG) ────────────────────────────────────
NEO4J_PASSWORD=CHANGER_MOI_neo4j_motdepasse_fort

# ── n8n (Orchestrateur) ──────────────────────────────────────
N8N_ENCRYPTION_KEY=CHANGER_MOI_cle_chiffrement_32_chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGER_MOI_motdepasse_fort

# ── Brilliant Directories ────────────────────────────────────
BD_WEBSITE_URL=https://VOTRE_DOMAINE_BRILLIANT_DIRECTORIES.com
BD_API_KEY=VOTRE_CLE_API_BD

# ── O*NET API (pour ETL) ─────────────────────────────────────
ONET_API_KEY=VOTRE_CLE_ONET
ONET_BASE_URL=https://api-v2.onetcenter.org/

# ── Chatbot RAG (API Cloud — production uniquement) ──────────
# Utiliser Anthropic Claude OU OpenAI GPT (jamais le modèle local en prod)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
